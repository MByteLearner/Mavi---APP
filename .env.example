# ── MAVI React Native Environment Variables Template ──

# Backend API Base URL (optional - auto-detected in Expo Go if left empty or commented out)
# EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Standalone Mocks mode (false = connect to real Core API backend)
EXPO_PUBLIC_USE_MOCKS=false

# API Timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Application Metadata
EXPO_PUBLIC_APP_NAME=MAVI
EXPO_PUBLIC_APP_VERSION=1.0.0
